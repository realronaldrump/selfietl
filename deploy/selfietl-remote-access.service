ExecStart=/home/davis/selfietl/.venv/bin/python -m selfietl.remote_access serve --public-origin https://davis-mini-pc-1.tail59b3f5.ts.net:10000/selfietl/ --data-dir /home/davis/.selfietl --port 8777
